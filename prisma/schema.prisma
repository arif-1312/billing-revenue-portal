generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PaymentReceived {
  YES
  NO
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderType {
  AMC
  FMS
  SOFTWARE
  OTHER
}

enum POStatus {
  LIVE
  CLOSED
}

enum PurchaseOrderType {
  MAIL
  AGREEMENT
  NORMAL
}

enum BillingCycleType {
  START
  MID
  END
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  remark    String?
  status    Status   @default(ACTIVE)
  /// Protected super-administrator role. Permissions still come from RoleModule.
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  roleModules RoleModule[]
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String   @unique
  password  String
  firstName String
  lastName  String
  email     String   @unique
  status    Status   @default(ACTIVE)
  remark    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roleId    String   @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id])

  notificationReceipts    NotificationReceipt[]
  notificationPreferences NotificationPreference[]
  emailJobs               EmailJob[]
  passwordResetTokens     PasswordResetToken[]
}

model Module {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String @unique(map: "module_name_idx")
  description String
  route       String @unique
  status      Status @default(ACTIVE)

  roleModules RoleModule[]

  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}

model RoleModule {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId   String @db.Uuid
  moduleId String @db.Uuid

  canView   Boolean @default(true)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
}

model PurchaseOrder {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerPONumber   String?
  poAmount           Decimal?         @db.Decimal(14, 2)
  serviceTypeId      String?          @db.Uuid
  contractId         String?          @db.Uuid
  startFrom          DateTime?
  endDate            DateTime?
  paymentTerms       String?
  customerId         String?          @db.Uuid
  billingPlanId      String?          @db.Uuid
  companyId          String?          @db.Uuid
  vendorId           String?          @db.Uuid
  poOwner            String?
  remark             String?
  purchaseOrderType  PurchaseOrderType?
  status             POStatus         @default(LIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  contractDurationId String?          @db.Uuid
  ageingDays         String?
  scope              String?
  billingCycles      BillingCycle[]
  billingPlan        BillingPlan?     @relation(fields: [billingPlanId], references: [id])
  contractDuration   ContractDuration? @relation(fields: [contractDurationId], references: [id])
  contract           ContractType?    @relation(fields: [contractId], references: [id])
  customer           Customer?        @relation(fields: [customerId], references: [id])
  ServiceType        ServiceType?     @relation(fields: [serviceTypeId], references: [id])
  company            Company?         @relation(fields: [companyId], references: [id])
  vendor             Vendor?          @relation(fields: [vendorId], references: [id])
}

model BillingCycle {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billingSubmittedDate DateTime?
  paymentReceived      PaymentReceived @default(NO)
  paymentReceivedDate  DateTime?
  paymentDueDate       DateTime?
  billingRemark        String?
  purchaseOrderId      String          @db.Uuid
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  collectedAmount      Decimal?        @db.Decimal(14, 2)
  invoiceAmount        Decimal?        @db.Decimal(14, 2)
  creditNote           Decimal         @default(0) @db.Decimal(14, 2)
  invoiceDate          DateTime?
  invoiceNumber        String
  tds                  Decimal         @default(0) @db.Decimal(12, 2)
  purchaseOrder        PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id])
  payments             BillingCyclePayment[]
}

model BillingCyclePayment {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billingCycleId String       @db.Uuid
  receivedDate   DateTime
  amount         Decimal      @db.Decimal(14, 2)
  createdAt      DateTime     @default(now())
  billingCycle   BillingCycle @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)

  @@index([billingCycleId])
  @@index([receivedDate])
}

model ServiceType {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @unique
  remark         String?
  status         Status          @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model BillingPlan {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String           @unique
  totalBillingCycles Int
  billingCycleType   BillingCycleType @default(START)
  remark             String?
  status             Status           @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  purchaseOrders     PurchaseOrder[]
  project            Project[]
}

model ContractDuration {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String          @unique
  totalNumberOfMonths Int
  remark              String?
  status              Status          @default(ACTIVE)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  purchaseOrders      PurchaseOrder[]
}

model ContractType {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @unique
  remark         String?
  status         Status          @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model Customer {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerCode   String          @unique
  firstName      String
  lastName       String?
  companyName    String?
  email          String?         @unique
  phone          String
  alternatePhone String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  gstNumber      String?         @unique
  panNumber      String?
  website        String?
  status         Status          @default(ACTIVE)
  remark         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model Vendor {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorCode     String          @unique
  firstName      String
  lastName       String?
  companyName    String?
  email          String?         @unique
  phone          String
  alternatePhone String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  gstNumber      String?         @unique
  panNumber      String?
  website        String?
  status         Status          @default(ACTIVE)
  remark         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model Company {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  companyCode    String?       @unique
  email          String?
  phone          String?
  alternatePhone String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  pincode        String?
  gstNumber      String?       @unique
  panNumber      String?
  cinNumber      String?
  status         CompanyStatus @default(ACTIVE)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  projects      Project[]
  purchaseOrder PurchaseOrder[]
}

model Project {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String    @db.Uuid
  projectName     String
  startDate       DateTime?
  endDate         DateTime?
  poValue         Decimal   @db.Decimal(12, 2)
  orderType       OrderType
  resourceCount   Int
  billingPlanId   String    @db.Uuid
  totalRevenue    Decimal   @default(0) @db.Decimal(12, 2)
  totalCost       Decimal   @default(0) @db.Decimal(12, 2)
  status          Status    @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  projectedProfit Decimal   @default(0) @db.Decimal(12, 2)

  company     Company     @relation(fields: [companyId], references: [id])
  billingPlan BillingPlan @relation(fields: [billingPlanId], references: [id])

  monthlyPLs ProjectMonthlyPL[]
}

model ProjectMonthlyPL {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  projectId String @db.Uuid

  month Int
  year  Int

  billedAmount   Decimal @db.Decimal(12, 2)
  fms            Decimal @default(0) @db.Decimal(12, 2)
  spare          Decimal @default(0) @db.Decimal(12, 2)
  otherCost      Json
  billableAmount Decimal @default(0) @db.Decimal(12, 2)
  resourceUsed   Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month, year])
}

model Configuration {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String?
  logo     String?
  favicon  String?
  email    String?
  password String?
}

enum NotificationCategory {
  PAYMENT
  INVOICE
  PURCHASE_ORDER
  CONTRACT
  SYSTEM
}

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum NotificationKind {
  STATE
  EVENT
}

/// Summary of related EmailJob rows. PENDING includes queued, processing, and retrying jobs.
enum NotificationEmailStatus {
  NOT_APPLICABLE
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  RETRYING
}

/// In-app billing and system alerts. Delivery attempts are stored on EmailJob.
model Notification {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dedupeKey        String                  @unique
  category         NotificationCategory
  eventType        String
  priority         NotificationPriority
  kind             NotificationKind
  title            String
  body             String
  customerName     String?
  companyName      String?
  invoiceNumber    String?
  poNumber         String?
  entityType       String
  entityId         String
  href             String?
  metadata         Json?
  emailEligible    Boolean                 @default(false)
  emailStatus      NotificationEmailStatus @default(NOT_APPLICABLE)
  emailTemplateKey String?
  emailSentAt      DateTime?
  occurredAt       DateTime                @default(now())
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  receipts         NotificationReceipt[]
  emailJobs        EmailJob[]

  @@index([category, occurredAt])
  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([kind])
  @@index([emailStatus])
}

model NotificationReceipt {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String    @db.Uuid
  userId         String    @db.Uuid
  readAt         DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, deletedAt, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String               @db.Uuid
  category     NotificationCategory
  inAppEnabled Boolean              @default(true)
  emailEnabled Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

/// Administrator switch for optional email categories. Missing rows stay enabled.
model EmailCategorySetting {
  category     NotificationCategory @id
  emailEnabled Boolean              @default(true)
  updatedAt    DateTime             @updatedAt
}

/// Durable outbox. SMTP credentials are never stored on these rows.
model EmailJob {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey   String         @unique
  notificationId   String?        @db.Uuid
  eventKey         String
  recipientUserId  String?        @db.Uuid
  recipientEmail   String
  cc               String[]       @default([])
  bcc              String[]       @default([])
  subject          String
  templateKey      String
  payload          Json
  status           EmailJobStatus @default(PENDING)
  attemptCount     Int            @default(0)
  maxAttempts      Int            @default(5)
  nextAttemptAt    DateTime       @default(now())
  lastAttemptAt    DateTime?
  sentAt           DateTime?
  lastError        String?
  lockedAt         DateTime?
  lockToken        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  notification     Notification?  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient        User?          @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([notificationId])
  @@index([recipientUserId])
  @@index([createdAt])
}

/// Single-use password reset secrets. Only the hash is stored.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model CreditNote {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  particulars String
  date        DateTime
  vchType     String
  vchNo       String
  amount      Decimal  @db.Decimal(14, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([vchType, vchNo])
}

model RateLimitBucket {
  key      String   @id
  count    Int
  resetAt  DateTime

  @@index([resetAt])
}

model AuditLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime    @default(now())
  userId    String?     @db.Uuid
  userName  String?
  action    AuditAction
  model     String
  recordId  String?
  before    Json?
  after     Json?
  changes   Json?

  @@index([createdAt])
  @@index([model, createdAt])
  @@index([action, createdAt])
  @@index([userId])
}
