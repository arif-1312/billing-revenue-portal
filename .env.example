# Copy to .env.local for local development and fill in the values.
# Production mode reads .env.production.local before this file.
# Do not put real passwords, API keys, or production database URLs in this file.

APP_ENV=development

NEXT_APP_APP_NAME="Billing and Revenue Portal"
NEXT_APP_DESCRIPTION="Billing and Revenue Portal"
NEXT_APP_SERVER_URL="http://localhost:3000"
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Local PostgreSQL for development.
# Production must use a different database, set on the host, not in this file.
# Use sslmode=require for any hosted PostgreSQL connection.
DATABASE_URL="postgresql://postgres:replace-with-local-password@localhost:5432/billing_revenue_dev"

# Generate a unique value per environment, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-unique-random-value"

# Encrypts the mailbox password at rest. Falls back to AUTH_SECRET when unset.
# Production should set a dedicated value that is not stored in the database.
CONFIG_ENCRYPTION_KEY="replace-with-another-unique-random-value"

# Development: http://localhost:3000
# Production: the public https URL of that deployment
AUTH_URL="http://localhost:3000"

# Login created by prisma db seed.
# Development can use a local-only password. Production must set a different password on the host.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="replace-with-a-long-unique-password"
SEED_ADMIN_EMAIL="admin@example.com"
